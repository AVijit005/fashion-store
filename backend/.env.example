# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Prisma)
DATABASE_URL="postgresql://aura_user:CHANGEME_db_password@localhost:5432/aura_db?schema=public&connection_limit=20&pool_timeout=30&statement_timeout=15000&lock_timeout=5000"

# Redis (BullMQ / Caching)
REDIS_URL="redis://localhost:6379"
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:3000"

# JWT Authentication
# Generate with: openssl rand -base64 64
JWT_SECRET="CHANGEME_generate_with_openssl_rand_base64_64"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"

# Razorpay Payments (For testing, use Razorpay Sandbox keys)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_CHANGEME_replace_from_razorpay_dashboard"
RAZORPAY_KEY_SECRET="CHANGEME_replace_with_razorpay_test_key_secret"
# Required. Get from: Razorpay Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET="CHANGEME_replace_with_razorpay_webhook_secret"

# Storage Configuration (AWS S3 / MinIO)
# Local MinIO credentials (configured in docker-compose.yml)
# Generate with: openssl rand -base64 32
AWS_ACCESS_KEY_ID="CHANGEME_minio_or_aws_access_key"
AWS_SECRET_ACCESS_KEY="CHANGEME_generate_with_openssl_rand_base64_32"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="aura-studio"
# Leave blank to use native AWS S3
AWS_S3_ENDPOINT="http://localhost:9000"

# Optional: Sentry error tracking (leave blank to disable)
SENTRY_DSN=""

# Optional: Redis cluster nodes (comma-separated host:port pairs)
# Leave blank to use REDIS_URL single-node
# REDIS_CLUSTER_NODES="node1:6379,node2:6379,node3:6379"

# Optional: Bootstrap admin user (used by `npm run bootstrap:admin`)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="CHANGEME_strong_admin_password_min_12_chars"

# Optional: Cookie signing secret (used for signed cookies)
# Generate with: openssl rand -base64 64
# COOKIE_SECRET="CHANGEME_generate_with_openssl_rand_base64_64"

# Optional: Transactional email (SMTP)
# Leave SMTP_HOST blank to disable sending (the email worker will log
# and retry; emails are not silently dropped — they accumulate in the
# email-queue until SMTP_HOST is configured).
# EMAIL_FROM='"Aura Streetwear" <no-reply@aurastreetwear.com>'
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="CHANGEME_smtp_provider_api_key"
# SMTP_SECURE="false"
# EMAIL_WORKER_DISABLED="false"

# Optional: Frontend origin used to build absolute URLs in transactional emails.
# In production this should be the canonical site origin (no trailing slash).
# FRONTEND_URL="https://aurastreetwear.com"
